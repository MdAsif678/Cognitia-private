# EVM Risk Analyzer Environment Configuration
# NOTE: Never provide private keys here. Only read-only RPCs are used for simulation forks.

# Primary EVM Chain ID (Default: 1 for Ethereum Mainnet)
DEFAULT_CHAIN_ID=1

# Read-only RPC URLs (Used for state reads and Anvil fork simulation)
ETHEREUM_RPC_URL="https://eth.llamarpc.com"
SEPOLIA_RPC_URL="https://rpc.sepolia.org"
POLYGON_RPC_URL="https://polygon-rpc.com"
ARBITRUM_RPC_URL="https://arb1.arbitrum.io/rpc"

# Local Anvil Worker Configuration
# If ANVIL_PATH is empty or anvil is not installed, the engine gracefully falls back
# to isolated in-memory simulation with explicit coverage tracking.
ANVIL_PATH="anvil"
ANVIL_PORT=8545
ANVIL_AUTO_SPAWN=true

# Optional Verified Contract Explorer API Key (for server-side ABI fetching)
# ETHERSCAN_API_KEY=""
