# --- Analysis API (services/api) ---
PORT=8080
HOST=0.0.0.0
LOG_LEVEL=info

# Upstream RPCs the forks read live state from (never used to send transactions).
# Defaults are keyless publicnode.com endpoints; an Alchemy/Infura URL is faster and not rate-limited.
# RPC_URL_1=https://eth-mainnet.g.alchemy.com/v2/<key>
# RPC_URL_11155111=https://eth-sepolia.g.alchemy.com/v2/<key>
# Limit which chains are served (default: all configured).
# SIM_CHAINS=11155111,1

# Forks
# ANVIL_PATH=/usr/local/bin/anvil        # default: ~/.foundry/bin/anvil, then PATH
MAX_CONCURRENT_FORKS=4
WARM_FORKS_PER_CHAIN=1                   # pre-started forks per chain; cuts ~2-3s per request
WARM_FORK_MAX_AGE_MS=30000               # recycle warm forks so pinned state stays recent

# Request handling
ANALYSIS_TIMEOUT_MS=45000                # after this the report is "failed / Analysis unavailable"
RATE_LIMIT_PER_MINUTE=60
CORS_ORIGINS=*                           # chrome-extension:// origins are always allowed
ENABLE_DEBUG_ROUTES=true                 # exposes POST /v1/simulate (raw simulator output)
