{
  "name": "cognitia",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "services/*",
    "apps/*",
    "incoming/swastik-risk-engine",
    "incoming/atif-extension"
  ],
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "build": "npm run build -w @cognitia/api && npm run build -w @cognitia/extension",
    "dev:api": "npm run dev -w @cognitia/api",
    "dev:demo": "node scripts/dev-demo.mjs",
    "deploy:local": "tsx scripts/deploy-local.ts",
    "test:demo": "tsx scripts/test-demo.ts",
    "test:packaged": "npm run build -w @cognitia/api && node scripts/test-packaged.mjs",
    "test:wallet": "node --test incoming/ps2-project/demo/wallet.test.mjs",
    "test:mainnet": "tsx scripts/test-mainnet.ts",
    "build:demo-extension": "node scripts/build-demo-extension.mjs",
    "test:extension": "npm run build:demo-extension && node scripts/test-extension.mjs",
    "fund:local": "tsx scripts/fund-local.ts",
    "demo:public": "node scripts/public-demo.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0"
  }
}
